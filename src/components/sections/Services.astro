---
import { ArrowRight } from "lucide-react";

const services = [
  {
    title: "Sistema Financeiro, Pagamentos & Fintechs",
    description: "Sustentamos plataformas que conectam todo o ecossistema financeiro, do Banco Central às adquirentes e instituições de pagamento. Integramos provedores, padronizamos fluxos e garantimos segurança, rastreabilidade e continuidade.",
    image: "https://images.unsplash.com/photo-1486325212027-8081e485255e?q=80&w=1200&auto=format&fit=crop",
    featured: true,
  },
  {
    title: "Indústria & Manufatura",
    description: "Digitalizamos processos fabris, conectando esteiras de produção aos sistemas de gestão corporativa.",
    image: "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=800&auto=format&fit=crop",
  },
  {
    title: "Saúde & Medicina",
    description: "Conectamos pacientes a provedores com conformidade estrita aos regulamentos de saúde.",
    image: "https://images.unsplash.com/photo-1516549655169-df83a0774514?q=80&w=800&auto=format&fit=crop",
  },
  {
    title: "Contabilidade, Fiscal & Financeiro Operacional",
    description: "Automação profunda e compliance absoluto para rotinas fiscais e contábeis de alto volume.",
    image: "https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?q=80&w=800&auto=format&fit=crop",
  },
  {
    title: "Governo, Utilities & Serviços Públicos",
    description: "Construímos pontes seguras entre munícipes, cidadãos e as gigantescas infraestruturas de serviços básicos.",
    image: "https://images.unsplash.com/photo-1486325212027-8081e485255e?q=80&w=800&auto=format&fit=crop",
  },
  {
    title: "Construção Civil & Engenharia",
    description: "Plataformas de eficiência, rastreabilidade técnica e gestão de suprimentos para o canteiro de obras.",
    image: "https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=800&auto=format&fit=crop",
  },
  {
    title: "Comércio & Varejo",
    description: "Sistemas complexos de PDV, gestão de estoque e orquestração multiplataforma integrando e-commerce.",
    image: "https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=800&auto=format&fit=crop",
  },
  {
    title: "Entretenimento & Experiências Digitais",
    description: "Plataformas ultra escaláveis preparadas para suportar tráfego explosivo em emissões de tickets e streaming.",
    image: "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?q=80&w=800&auto=format&fit=crop",
  },
  {
    title: "Social, Franquias & Plataformas Digitais",
    description: "Redes engajadas, apps corporativos e ferramentas de gestão consolidadas que expandem marcas.",
    image: "https://images.unsplash.com/photo-1521737604893-d14cc237f11d?q=80&w=800&auto=format&fit=crop",
  }
];
---

<section id="setores" class="bg-[#f0f4f8] px-6 py-24 md:py-32">
  <div class="mx-auto max-w-[1400px] space-y-14">
    
    <!-- Header: two-column layout exactly like globals.com -->
    <div class="service-header grid gap-6 lg:grid-cols-2 lg:items-end">
      <!-- Left: eyebrow + large title -->
      <div class="space-y-2">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">// SEGMENTOS</p>
        <h2 class="text-[clamp(2.5rem,5vw,4.5rem)] font-extralight text-slate-900 leading-[1.1] tracking-tight">
          Projetamos e<br>
          <strong class="font-bold">operamos software</strong>
        </h2>
      </div>
      <!-- Right: description paragraph -->
      <div class="lg:pb-3 lg:pl-8">
        <p class="text-base text-slate-500 leading-relaxed max-w-md">
          Atuamos nos segmentos mais exigentes, oferecendo software e serviços de sistema 
          para aplicações de segurança, missão e negócios críticos.
        </p>
      </div>
    </div>

    <!-- Cards Grid: 4-column, matching globals.com -->
    <div class="services-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-slate-300/50">
      {services.map((service, i) => (
        <a
          href="#"
          class:list={[
            "service-card group relative overflow-hidden bg-slate-900 cursor-pointer block",
            "aspect-4/5",
            service.featured ? "sm:col-span-2 sm:row-span-2" : "",
          ]}
          data-index={i}
        >
          <!-- Background Image -->
          <div
            class="absolute inset-0 bg-cover bg-center transition-transform duration-1200 ease-in-out group-hover:scale-110"
            style={`background-image: url('${service.image}');`}
          />

          <!-- Grayscale overlay that becomes more transparent on hover -->
          <div class="absolute inset-0 bg-slate-800/60 grayscale transition-all duration-700 group-hover:bg-slate-800/40 group-hover:grayscale-0" />
          
          <!-- Deep gradient at bottom for text readability -->
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(2,6,23,0.92), rgba(15,23,42,0.3), transparent);" />
          
          <!-- Top-right arrow -->
          <div class="absolute top-5 right-5 w-8 h-8 flex items-center justify-center text-white/50 transition-all duration-500 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7M7 7h10v10"/>
            </svg>
          </div>

          <!-- Content at bottom -->
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-7">
            <h3 class:list={[
              "font-bold text-white leading-tight transition-transform duration-500 group-hover:-translate-y-1",
              service.featured ? "text-xl md:text-2xl" : "text-base md:text-lg",
            ]}>
              {service.title}
            </h3>

            {/* Description: hidden by default, smoothly revealed on hover */}
            <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] transition-[grid-template-rows] duration-500 ease-in-out">
              <div class="overflow-hidden">
                <p class:list={[
                  "text-slate-300 leading-relaxed opacity-0 transition-opacity duration-500 delay-75 group-hover:opacity-100 mt-3",
                  service.featured ? "text-sm md:text-base" : "text-xs md:text-sm",
                ]}>
                  {service.description}
                </p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  // Intersection Observer for scroll-triggered entrance animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.service-header, .service-card').forEach(el => {
    observer.observe(el);
  });
</script>

<style>
  /* Entrance animations on scroll */
  .service-header {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .service-header.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .service-card {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .service-card.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger the card animations using CSS */
  .service-card:nth-child(1) { transition-delay: 0ms; }
  .service-card:nth-child(2) { transition-delay: 60ms; }
  .service-card:nth-child(3) { transition-delay: 120ms; }
  .service-card:nth-child(4) { transition-delay: 180ms; }
  .service-card:nth-child(5) { transition-delay: 240ms; }
  .service-card:nth-child(6) { transition-delay: 300ms; }
  .service-card:nth-child(7) { transition-delay: 360ms; }
  .service-card:nth-child(8) { transition-delay: 420ms; }
  .service-card:nth-child(9) { transition-delay: 480ms; }
</style>
