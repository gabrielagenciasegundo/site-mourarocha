---
const features = [
  {
    title: "Performance Garantida",
    description: "Operação contínua com 99.9% de uptime para sistemas críticos de missão.",
  },
  {
    title: "Segurança de Dados",
    description: "Proteção multicamada, conformidade LGPD e criptografia em repouso e em trânsito.",
  },
  {
    title: "Escalabilidade Elástica",
    description: "Arquitetura cloud-native que absorve picos de tráfego sem degradação.",
  },
  {
    title: "Integração Nativa",
    description: "Conectamos com qualquer ecossistema usando APIs, EDI e protocolos industriais.",
  },
  {
    title: "Observabilidade Total",
    description: "Monitoramento em tempo real, alertas inteligentes e rastreabilidade completa.",
  },
  {
    title: "Suporte 24/7",
    description: "Time de engenharia dedicado com resposta a incidentes críticos em minutos.",
  },
];
---

<section id="essencial" class="bg-[#0f172a] text-white px-6 py-24 md:py-36 overflow-hidden relative">
  <!-- Subtle grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(white 1px, transparent 1px), linear-gradient(90deg, white 1px, transparent 1px); background-size: 80px 80px;">
  </div>

  <div class="mx-auto max-w-[1400px] relative z-10 space-y-16">
    <!-- Header -->
    <div class="features-header max-w-3xl space-y-4">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">// O QUE ENTREGAMOS</p>
      <h2 class="text-[clamp(2.5rem,5vw,4.5rem)] font-extralight leading-[1.1] tracking-tight text-white">
        Cuidamos do<br>
        <strong class="font-bold">essencial</strong>
      </h2>
    </div>

    <!-- Features Grid -->
    <div class="features-grid grid gap-px sm:grid-cols-2 lg:grid-cols-3 bg-white/5">
      {features.map((feature, i) => (
        <div
          class="feature-item group bg-[#0f172a] p-8 md:p-10 space-y-4 hover:bg-white/5 transition-colors duration-300 cursor-default"
          data-index={i}
        >
          <!-- Number accent -->
          <span class="text-xs font-mono text-primary/70 tracking-widest">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="text-lg font-bold text-white group-hover:text-primary transition-colors duration-300">
            {feature.title}
          </h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.features-header, .feature-item').forEach(el => {
    observer.observe(el);
  });
</script>

<style>
  .features-header {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .features-header.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .feature-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .feature-item.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .feature-item:nth-child(1) { transition-delay: 0ms; }
  .feature-item:nth-child(2) { transition-delay: 80ms; }
  .feature-item:nth-child(3) { transition-delay: 160ms; }
  .feature-item:nth-child(4) { transition-delay: 240ms; }
  .feature-item:nth-child(5) { transition-delay: 320ms; }
  .feature-item:nth-child(6) { transition-delay: 400ms; }
</style>
