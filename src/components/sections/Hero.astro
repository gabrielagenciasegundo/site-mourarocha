---
---

<section
  id="hero"
  class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-slate-950 text-center"
>
  <!-- Dark cinematic background overlay with subtle noise texture -->
  <div class="absolute inset-0 z-0">
    <!-- Subtle radial glow from center -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_50%_50%,rgba(31,63,145,0.15),transparent_70%)]"></div>

    <!-- Grid lines overlay -->
    <div class="absolute inset-0 opacity-[0.04]"
      style="background-image: linear-gradient(rgba(255,255,255,0.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.6) 1px, transparent 1px); background-size: 80px 80px;">
    </div>
    
    <!-- Background "tech" image collage - simulating the globals video feel -->
    <div class="absolute inset-0 overflow-hidden opacity-20">
      <img 
        src="https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=2400&auto=format&fit=crop"
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
      />
    </div>
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(2,6,23,0.5), rgba(2,6,23,0.2), rgba(2,6,23,0.8));"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-5xl px-6 flex flex-col items-center gap-8">
    
    <!-- Eyebrow -->
    <div class="hero-fade-in flex items-center gap-3 text-slate-400 text-sm tracking-[0.2em] uppercase font-medium" style="--delay: 0ms">
      <span class="block h-px w-8 bg-primary/70"></span>
      Missão Crítica
      <span class="block h-px w-8 bg-primary/70"></span>
    </div>

    <!-- Main headline -->
    <h1 class="text-[clamp(3rem,8vw,7rem)] font-extrabold tracking-tighter leading-none text-white">
      <span class="hero-fade-in block" style="--delay: 100ms">Silenciosa.</span>
      <span class="hero-fade-in block" style="--delay: 200ms">Ininterrupta.</span>
      <span class="hero-fade-in block text-primary" style="--delay: 300ms">Essencial.</span>
    </h1>

    <!-- Subheadline -->
    <p class="hero-fade-in mx-auto max-w-2xl text-base text-slate-400 sm:text-lg md:text-xl leading-relaxed" style="--delay: 450ms">
      Desenvolvemos e operamos sistemas de missão crítica — soluções digitais
      que exigem alta disponibilidade, precisão e confiabilidade.
    </p>

    <!-- CTAs -->
    <div class="hero-fade-in flex flex-col sm:flex-row items-center gap-4 pt-2" style="--delay: 600ms">
      <a
        href="#contato"
        class="h-12 px-8 text-sm font-semibold text-slate-900 bg-white hover:bg-slate-100 transition-all duration-300 flex items-center justify-center rounded-sm shadow-lg hover:shadow-xl"
      >
        Falar com a MouraRocha
      </a>
      <a
        href="#setores"
        class="h-12 px-8 text-sm font-semibold text-white border border-white/30 hover:border-white/60 hover:bg-white/5 transition-all duration-300 flex items-center justify-center rounded-sm"
      >
        Explorar Setores
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2">
    <div class="bounce-arrow text-white/40">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFadeUp 0.8s ease forwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .bounce-arrow {
    animation: chevronBounce 2s ease-in-out infinite;
  }

  @keyframes chevronBounce {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50% { transform: translateY(6px); opacity: 0.8; }
  }
</style>
