---
import robo1 from "@/assets/images/robo1.png";
import robo2 from "@/assets/images/robo2.png";
import robo3 from "@/assets/images/robo3.png";
---

<section
  id="hero"
  class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden text-center"
  style="background-color: #243588;"
>
  <!-- Subtle grid overlay -->
  <div class="absolute inset-0 z-0 opacity-[0.06]"
    style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 70px 70px;">
  </div>

  <!-- Blue radial glow at bottom -->
  <div class="absolute inset-0 z-0" style="background: radial-gradient(ellipse 80% 50% at 50% 110%, rgba(255,255,255,0.08), transparent 70%);"></div>

  <!-- Robot images — left and right panels -->
  <div class="absolute inset-0 z-0 flex items-end justify-between pointer-events-none select-none">
    <!-- Left robot -->
    <div class="robot-left relative h-[70%] w-auto max-w-[300px] opacity-0 hidden md:block">
      <img
        src={robo3.src}
        alt=""
        class="h-full w-auto object-contain object-bottom drop-shadow-2xl"
        loading="eager"
      />
    </div>

    <!-- Right robots -->
    <div class="robot-right relative h-[65%] w-auto max-w-[280px] opacity-0 hidden md:block">
      <img
        src={robo2.src}
        alt=""
        class="h-full w-auto object-contain object-bottom drop-shadow-2xl"
        loading="eager"
      />
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl px-6 flex flex-col items-center gap-8">

    <!-- Label -->
    <div class="hero-fade-in flex items-center gap-3 text-white/60 text-xs tracking-[0.25em] uppercase font-medium" style="--delay: 0ms">
      <span class="block h-px w-8 bg-white/40"></span>
      Jurídico para o digital
      <span class="block h-px w-8 bg-white/40"></span>
    </div>

    <!-- Main headline -->
    <h1 class="text-[clamp(2.8rem,7vw,6.5rem)] font-bold tracking-tight leading-[1.05] text-white">
      <span class="hero-fade-in block" style="--delay: 100ms">Jurídico para</span>
      <span class="hero-fade-in block" style="--delay: 200ms">quem cria,</span>
      <span class="hero-fade-in block" style="--delay: 300ms; color: rgba(255,255,255,0.75);">inova e cresce</span>
      <span class="hero-fade-in block" style="--delay: 400ms">no digital.</span>
    </h1>

    <!-- Subheadline -->
    <p class="hero-fade-in mx-auto max-w-xl text-base text-white/70 sm:text-lg leading-relaxed" style="--delay: 550ms">
      A Moura Rocha é o escritório especializado em negócios de tecnologia, startups, agências de marketing e empresas que usam IA.
    </p>

    <!-- CTAs -->
    <div class="hero-fade-in flex flex-col sm:flex-row items-center gap-4 pt-2" style="--delay: 700ms">
      <a
        href="#contato"
        class="h-12 px-8 text-sm font-semibold text-primary bg-white hover:bg-slate-100 transition-all duration-300 flex items-center justify-center rounded-sm shadow-lg hover:shadow-xl"
        style="color: #243588;"
      >
        Falar com a equipe
      </a>
      <a
        href="#areas"
        class="h-12 px-8 text-sm font-semibold text-white border border-white/30 hover:border-white/60 hover:bg-white/10 transition-all duration-300 flex items-center justify-center rounded-sm"
      >
        Ver áreas de atuação
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2">
    <div class="bounce-arrow text-white/40">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFadeUp 0.8s ease forwards;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .bounce-arrow {
    animation: chevronBounce 2s ease-in-out infinite;
  }

  @keyframes chevronBounce {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50% { transform: translateY(6px); opacity: 0.8; }
  }

  .robot-left {
    animation: robotSlideLeft 1s ease 0.4s forwards;
  }

  .robot-right {
    animation: robotSlideRight 1s ease 0.6s forwards;
  }

  @keyframes robotSlideLeft {
    from { opacity: 0; transform: translateX(-40px) translateY(20px); }
    to   { opacity: 0.85; transform: translateX(0) translateY(0); }
  }

  @keyframes robotSlideRight {
    from { opacity: 0; transform: translateX(40px) translateY(20px); }
    to   { opacity: 0.85; transform: translateX(0) translateY(0); }
  }
</style>
