---
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-4 px-6"
>
  <div class="mx-auto max-w-[1400px] flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <span class="text-white text-2xl font-black tracking-tighter leading-none">
        moura<span class="text-primary">rocha</span>
      </span>
      <span class="hidden sm:block text-[10px] text-white/60 uppercase tracking-[0.2em] leading-tight ml-1 border-l border-white/30 pl-2">
        MISSÃO<br>CRÍTICA
      </span>
    </a>

    <!-- Center Nav (desktop) -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="#setores" class="nav-link text-sm font-medium tracking-wide transition-colors duration-200">Setores</a>
      <a href="#plataformas" class="nav-link text-sm font-medium tracking-wide transition-colors duration-200">Plataformas</a>
      <a href="#sobre" class="nav-link text-sm font-medium tracking-wide transition-colors duration-200">Sobre</a>
      <a href="#contato" class="nav-link text-sm font-medium tracking-wide transition-colors duration-200">Carreiras</a>
    </nav>

    <!-- Right CTAs -->
    <div class="flex items-center gap-4">
      <a
        href="#contato"
        id="navbar-cta"
        class="hidden sm:flex items-center justify-center h-10 px-5 text-sm font-medium border border-white/80 text-white hover:bg-white hover:text-slate-900 transition-all duration-300 rounded-sm"
      >
        Falar com a MouraRocha
      </a>
      <!-- Mobile Hamburger -->
      <button id="menu-toggle" class="md:hidden text-white p-2" aria-label="Menu">
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu (flex-col is toggled via JS, uses display:none by default) -->
  <div id="mobile-menu" class="mobile-menu-panel absolute top-full left-0 right-0 py-6 px-6 flex-col gap-4 border-t border-white/10" style="display:none; background: rgba(8,12,28,0.97); backdrop-filter: blur(20px);">
    <a href="#setores" class="text-white/80 hover:text-white text-base font-medium py-2 transition-colors">Setores</a>
    <a href="#plataformas" class="text-white/80 hover:text-white text-base font-medium py-2 transition-colors">Plataformas</a>
    <a href="#sobre" class="text-white/80 hover:text-white text-base font-medium py-2 transition-colors">Sobre</a>
    <a href="#contato" class="text-white/80 hover:text-white text-base font-medium py-2 transition-colors">Carreiras</a>
    <a href="#contato" class="mt-2 flex items-center justify-center h-11 px-5 text-sm font-medium border border-white/80 text-white hover:bg-white hover:text-slate-900 transition-all duration-300 rounded-sm">
      Falar com a MouraRocha
    </a>
  </div>
</header>

<style>
  /* Default: transparent on hero */
  #navbar {
    background: transparent;
  }

  /* Nav link default color (on dark hero) */
  #navbar .nav-link {
    color: rgba(255, 255, 255, 0.75);
  }
  #navbar .nav-link:hover {
    color: rgba(255, 255, 255, 1);
  }

  /* Scrolled dark state (still in hero viewport) */
  #navbar.scrolled {
    background: rgba(8, 12, 28, 0.9);
    backdrop-filter: blur(20px);
    box-shadow: 0 4px 30px rgba(0,0,0,0.3);
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  /* Light state (past hero, in light sections) */
  #navbar.light-section {
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(20px);
    box-shadow: 0 1px 20px rgba(0,0,0,0.08);
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  #navbar.light-section .nav-link {
    color: rgba(15, 23, 42, 0.65);
  }
  #navbar.light-section .nav-link:hover {
    color: rgb(15, 23, 42);
  }
  #navbar.light-section .text-white {
    color: rgb(15, 23, 42) !important;
  }
  #navbar.light-section .text-white\/60 {
    color: rgba(15, 23, 42, 0.5) !important;
  }
  #navbar.light-section #navbar-cta {
    border-color: rgba(31, 63, 145, 0.5);
    color: #1f3f91;
  }
  #navbar.light-section #navbar-cta:hover {
    background: #1f3f91;
    color: white;
  }
  #navbar.light-section #menu-toggle {
    color: rgb(15, 23, 42);
  }
  #navbar.light-section .border-white\/30 {
    border-color: rgba(15, 23, 42, 0.2) !important;
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.style.display === 'flex';
    if (mobileMenu) mobileMenu.style.display = isOpen ? 'none' : 'flex';
    iconMenu?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (mobileMenu) mobileMenu.style.display = 'none';
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });

  const heroSection = document.getElementById('hero');

  const handleScroll = () => {
    if (!navbar) return;
    const scrollY = window.scrollY;
    const heroHeight = heroSection?.offsetHeight ?? 600;

    if (scrollY > heroHeight - 80) {
      navbar.classList.remove('scrolled');
      navbar.classList.add('light-section');
    } else if (scrollY > 50) {
      navbar.classList.add('scrolled');
      navbar.classList.remove('light-section');
    } else {
      navbar.classList.remove('scrolled', 'light-section');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>
