---
import { ArrowRight } from "lucide-react";

const platforms = [
  {
    title: "Totals One",
    subtitle: "Núcleo de Borda BaaS",
    description: "Plataforma de missão crítica para estruturas BaaS. Conecta liquidantes, cores bancários, instituidoras, iniciadores de pagamento e provedores. App, Internet Banking, Backoffice, APIs completas e telemetria em tempo real.",
    className: "lg:col-span-1 lg:row-span-2 min-h-[500px]",
    image: "/images/placeholders/server-rack.jpg"
  },
  {
    title: "Totals Early",
    subtitle: "Governança de Recebíveis",
    description: "Visão consolidada e antecipação transparente com modelagem preditiva e prevenção rigorosa de fraudes operacionais.",
    className: "lg:col-span-1 lg:row-span-2 min-h-[500px]",
    image: "/images/placeholders/cube.jpg"
  },
  {
    title: "Totals Cognit",
    subtitle: "IA Conversacional Operacional",
    description: "Automação com inteligência artificial para atendimento em esteiras de operação complexa e missão crítica.",
    className: "lg:col-span-1 lg:row-span-1 min-h-[300px]",
    image: "/images/placeholders/neural.jpg"
  },
  {
    title: "Totals Lince",
    subtitle: "Antecipação Performada",
    description: "Maior fluxo de caixa corporativo projetado para reduzir a volatilidade dos fundos gerenciados.",
    className: "lg:col-span-1 lg:row-span-1 min-h-[300px]",
    image: "/images/placeholders/lens.jpg"
  },
  {
    title: "Monitoramento 24x7",
    subtitle: "Operação Contínua 24x7",
    description: "Supervisão ininterrupta. Redundância e fail-overs automatizados para sua plataforma não ter downtime.",
    className: "lg:col-span-2 lg:row-span-1 min-h-[300px]",
    image: "/images/placeholders/globe.jpg"
  }
];
---

<section id="plataformas" class="bg-slate-50 px-6 py-24 md:py-32">
  <div class="mx-auto max-w-[1400px] space-y-16">
    
    <!-- 2-Column Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="col-span-1 lg:col-span-7 space-y-4">
        <p class="text-sm font-semibold tracking-[0.2em] text-slate-400 uppercase">
          // NOSSAS PLATAFORMAS
        </p>
        <h2 class="text-3xl md:text-6xl lg:text-[72px] font-bold tracking-tighter leading-[1.05] text-slate-900">
          Tecnologia que
          <br class="hidden md:block"/>
          <span class="text-slate-400">governa operações.</span>
        </h2>
      </div>
      <div class="col-span-1 lg:col-span-5 lg:pt-12">
        <p class="text-lg md:text-md text-slate-600 leading-relaxed font-light max-w-lg">
          Plataformas especializadas para operações de missão crítica. 
          Cada produto nasce da nossa experiência em ambientes regulados e de alta exigência.
        </p>
      </div>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 ">
      {platforms.map((platform, index) => (
        <a 
          href="#contato" 
          class={`service-card block relative overflow-hidden bg-[#0f172a] group ${platform.className}`}
        >
          <!-- Background Placeholder (Darkened state) -->
          <div class="absolute inset-0 bg-[#0f172a]/90 transition-all duration-700 ease-in-out group-hover:bg-[#0f172a]/70 z-10"></div>
          
          <!-- Image (scales on hover) -->
          <div class="absolute inset-0 bg-slate-800 transition-transform duration-[1.2s] ease-out group-hover:scale-105 z-0">
             <!-- Abstract grid background as fallback since we don't have images -->
             <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at center, white 1px, transparent 1px); background-size: 20px 20px;"></div>
          </div>

          <!-- Arrow Icon (Top Right) -->
          <div class="absolute top-6 right-6 z-20 text-white/50 transition-all duration-500 transform group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-white">
            <ArrowRight class="w-5 h-5 -rotate-45" />
          </div>

          <!-- Content (Bottom anchord) -->
          <div class="absolute bottom-0 left-0 right-0 p-8 z-20 flex flex-col justify-end">
            <h3 class="text-2xl font-bold text-white tracking-tight mb-1">{platform.title}</h3>
            <p class="text-white/80 font-medium text-sm transition-transform duration-500 transform translate-y-0 relative z-30">{platform.subtitle}</p>
            
            <!-- Hidden Description Revealed on Hover -->
            <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] transition-[grid-template-rows] duration-500 ease-in-out">
              <div class="overflow-hidden">
                <p class="text-white/70 text-sm mt-4 leading-relaxed opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
                  {platform.description}
                </p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  /* Optional: Smooth fade in for scroll if needed, reusing the intersection observer approach from global.css or Hero */
</style>
