---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Server, Database, Activity, ShieldCheck, Cpu } from "lucide-react";
---

<section class="bg-slate-50 px-6 py-24 md:py-32">
  <div class="mx-auto max-w-6xl space-y-16">
    <div class="text-center max-w-2xl mx-auto space-y-4">
      <h2 class="text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
        Tecnologia que <span class="text-primary">governa</span> operações
      </h2>
      <p class="text-lg text-slate-600">
        Nossa arquitetura de software é pensada para robustez, 
        confiabilidade e processamento de alto volume.
      </p>
    </div>

    {/* Mixed Grid Layout */}
    <div class="grid gap-6 md:grid-cols-3">
      
      {/* Large Featured Card */}
      <Card className="md:col-span-2 group overflow-hidden border-0 bg-white shadow-sm hover:shadow-md transition-all duration-300" client:load>
        <CardContent className="p-0 h-full flex flex-col md:flex-row">
          <div class="p-8 md:p-12 flex-1 flex flex-col justify-center space-y-4">
            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-2">
              <Server class="w-6 h-6" />
            </div>
            <CardTitle className="text-2xl font-bold text-slate-900">Cloud & Infraestrutura</CardTitle>
            <p class="text-slate-600 leading-relaxed">
              Provisionamos e gerenciamos servidores dedicados e ambientes serverless, 
              garantindo que sua aplicação tenha os recursos necessários em tempo real.
            </p>
          </div>
          <div class="md:w-1/3 bg-slate-100 relative min-h-48 overflow-hidden">
             <!-- Abstract visual decoration -->
             <div class="absolute inset-0 flex items-center justify-center opacity-10">
                <Cpu class="w-48 h-48 text-primary" />
             </div>
          </div>
        </CardContent>
      </Card>

      {/* Standard Card 1 */}
      <Card className="border-0 bg-white shadow-sm hover:shadow-md transition-all duration-300" client:load>
        <CardContent className="p-8 space-y-4 h-full flex flex-col justify-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-2">
            <Database class="w-6 h-6" />
          </div>
          <CardTitle className="text-xl font-bold text-slate-900">Data & AI</CardTitle>
          <p class="text-slate-600">
            Pipelines de dados eficientes para treinamento e inferência de modelos analíticos.
          </p>
        </CardContent>
      </Card>

      {/* Standard Card 2 */}
      <Card className="border-0 bg-white shadow-sm hover:shadow-md transition-all duration-300" client:load>
        <CardContent className="p-8 space-y-4 h-full flex flex-col justify-center">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary mb-2">
            <Activity class="w-6 h-6" />
          </div>
          <CardTitle className="text-xl font-bold text-slate-900">Monitoring</CardTitle>
          <p class="text-slate-600">
            Observabilidade total com telemetria avançada e dashboards de saúde em tempo real.
          </p>
        </CardContent>
      </Card>

      {/* Standard Card 3 */}
      <Card className="md:col-span-2 border-0 bg-white shadow-sm hover:shadow-md transition-all duration-300" client:load>
        <CardContent className="p-8 flex flex-col sm:flex-row items-center gap-6 h-full">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center text-primary shrink-0">
            <ShieldCheck class="w-6 h-6" />
          </div>
          <div>
            <CardTitle className="text-xl font-bold text-slate-900 mb-2">Segurança Zero-Trust</CardTitle>
            <p class="text-slate-600 md:pr-12">
              Implementamos camadas múltiplas de defesa e auditorias contínuas para proteger 
              senhas, acessos e transações sensíveis.
            </p>
          </div>
        </CardContent>
      </Card>

    </div>
  </div>
</section>
